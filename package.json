{
  "name": "power-strip",
  "private": true,
  "version": "0.0.0",
  "description": "3D 化的宿舍电器交互与排插功率可视化系统",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "npm run build -- --base=/power-strip/",
